# KitStak MCP server. Copy to .env (gitignored) or put these in your MCP client config.

# Read-only role connection (sql/readonly-role.sql), through the Supabase pooler, e.g.
#   postgres://kitstak_mcp_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Never use the app's DATABASE_URL or the service role key here: the server refuses a role that can write.
KITSTAK_MCP_DATABASE_URL=

# Organization slug (or uuid) whose warehouse this server reads, e.g. kitstak
KITSTAK_MCP_ORG=

# Optional: comma separated client codes to narrow every tool to, e.g. FRIDA,ONYX
KITSTAK_MCP_CLIENTS=

# Optional: default row limit for list tools (default 50, max 200)
KITSTAK_MCP_DEFAULT_LIMIT=
