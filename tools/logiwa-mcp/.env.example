# Logiwa iO MCP server (read only). Copy to .env (gitignored) or put these in your MCP client config.
# Never commit real values. Never paste them into a chat.

# Option A (recommended): a dedicated Logiwa iO API user. The server logs in with
# POST /v3.1/Authorize/token and keeps the token in memory only.
LOGIWA_MCP_EMAIL=
LOGIWA_MCP_PASSWORD=

# Option B: a token Logiwa issued you directly. If set, it is used instead of email/password.
LOGIWA_MCP_TOKEN=

# Optional: API host. Production is https://myapi.logiwa.com, sandbox is https://myapisandbox.logiwa.com
LOGIWA_MCP_BASE_URL=

# Optional: comma separated Logiwa client identifiers (GUIDs) to narrow every tool to,
# e.g. only Explore Scientific. Empty means every client the API user can see.
LOGIWA_MCP_CLIENTS=

# Optional: default page size for list tools (default 50, max 200)
LOGIWA_MCP_PAGE_SIZE=

# Optional: request timeout in milliseconds (default 30000)
LOGIWA_MCP_TIMEOUT_MS=

# Optional: 0 to stop sending filters to Logiwa and filter rows locally only
LOGIWA_MCP_SERVER_FILTERS=
