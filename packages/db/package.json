{
  "name": "@kitstak/db",
  "version": "0.1.0",
  "private": true,
  "description": "Shared KitStak core database layer: Drizzle schema for the core/crm/wms pgSchemas, driver factories, and core migrations (TypeScript source-shipped \u2014 consumers transpile via Next transpilePackages).",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/core/auth": "./src/schema/core/auth.ts",
    "./schema/core/auth-policy": "./src/schema/core/auth-policy.ts",
    "./schema/core/rate-limit": "./src/schema/core/rate-limit.ts",
    "./password-change": "./src/password-change.ts",
    "./client-pg": "./src/client-pg.ts",
    "./client-postgres-js": "./src/client-postgres-js.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "migrate:wms-identity": "tsx scripts/migrate-wms-identity.ts"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kitstak/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "postgres": "3.4.9",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
