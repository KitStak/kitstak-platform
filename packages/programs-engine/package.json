{
  "name": "@kitstak/programs-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure money and planning engine for KitStak Programs: price resolution, accrual and posting, month charges, rollups, forecasts, variants, imports, schedules, runs, deal helpers, formatting and barcodes. Zero runtime dependencies, no database. Shared by Projects, Pulse, CRM (through pm-bridge) and WMS so every app shows the same numbers. TypeScript source-shipped (consumers transpile via Next transpilePackages).",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money.ts",
    "./calendar": "./src/calendar.ts",
    "./price": "./src/price.ts",
    "./accrual": "./src/accrual.ts",
    "./month": "./src/month.ts",
    "./forecast": "./src/forecast.ts",
    "./rollup": "./src/rollup.ts",
    "./variants": "./src/variants.ts",
    "./schedule": "./src/schedule.ts",
    "./runs": "./src/runs.ts",
    "./import": "./src/import.ts",
    "./projection": "./src/projection.ts",
    "./deal": "./src/deal.ts",
    "./format": "./src/format.ts",
    "./barcode": "./src/barcode.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@kitstak/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
