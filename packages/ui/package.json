    "./theme": "./src/theme/index.ts"
  },
  "dependencies": {
    "radix-ui": "1.8.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
