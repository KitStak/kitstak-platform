{
  "name": "@kitstak/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared KitStak design tokens, theme, and UI primitives (TypeScript source-shipped — consumers transpile via Next transpilePackages).",
  "sideEffects": [
    "**/*.css"
