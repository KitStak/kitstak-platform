{
  "name": "@kitstak/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared KitStak design tokens, theme, and UI primitives (TypeScript source-shipped \u2014 consumers transpile via Next transpilePackages).",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./app-switcher": "./src/app-switcher/index.ts",
    "./logo": "./src/logo/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./theme": "./src/theme/index.ts",
    "./theme-handoff": "./src/theme/handoff.tsx",
    "./handoff": "./src/handoff/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "radix-ui": "1.8.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@kitstak/config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "31.0.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
