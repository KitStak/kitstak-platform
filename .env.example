# KitStak WMS environment variables.
# Copy to .env.local and fill in real values. .env.local is gitignored.

# Secret used to sign the "kitstak_session" JWT cookie (HS256).
# Required in production (the app throws at first use if missing).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
