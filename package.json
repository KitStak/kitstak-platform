{
  "name": "kitstak",
  "version": "0.1.0",
  "private": true,
  "description": "KitStak platform monorepo — Portal, CRM, WMS and Projects, deeply integrated, independently licensable.",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:crm": "turbo dev --filter=kitstak-crm",
    "dev:wms": "turbo dev --filter=kitstak-wms",
    "dev:portal": "turbo dev --filter=kitstak-portal",
    "dev:projects": "turbo dev --filter=kitstak-projects",
    "dev:web": "turbo dev --filter=kitstak-web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
