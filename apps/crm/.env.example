# Copy to .env.local and fill in. Never commit real secrets.
NODE_ENV=development
# Local embedded Postgres (npm run db:start) listens on 5544.
DATABASE_URL=postgres://postgres:postgres@localhost:5544/kitstak
# On Vercel with the Supabase integration, DATABASE_URL may be left unset: POSTGRES_URL and
# POSTGRES_URL_NON_POOLING are used instead. DATABASE_URL_UNPOOLED overrides the latter.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Dedicated KDF input for webhook-secret encryption (recommended; min 32 chars; generate like
# BETTER_AUTH_SECRET). When unset, the key falls back to a derivation of the SHARED
# BETTER_AUTH_SECRET (deprecated: any KitStak app's env compromise would disclose webhook
# secrets, and rotating the shared secret bricks decryption). Changing it requires
# re-encrypting existing webhooks.secret_ciphertext (regenerate each webhook secret).
WEBHOOK_KDF_SECRET=
BETTER_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Optional: comma-separated extra origins allowed to make mutating API calls.
# TRUSTED_ORIGINS=
# Optional: log level (debug|info|warn|error).
# LOG_LEVEL=info

# Optional: send as `x-health-token` to get version/uptime/latency from /api/v1/health in production.
# HEALTH_TOKEN=

# Optional: number of trusted reverse proxies that append to X-Forwarded-For (default 1).
# The client IP (audit log, IP allow-list) is the entry just left of those hops; 0 ignores the header.
# TRUSTED_PROXY_HOPS=1

# Optional: uploads use local disk under UPLOAD_DIR by default. When a Vercel Blob store is
# connected (BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID), they go to that private store instead.
# UPLOAD_DIR=.data/uploads
# MAX_UPLOAD_BYTES=26214400

# --- Entitlements (BLUEPRINT.md §3) -----------------------------------------

# Module entitlement gate (Stripe deferred: grants are manual via
# `pnpm --filter @kitstak/entitlements grant`). UNSET = allow-all everywhere except
# NODE_ENV=production (dev/test/e2e never touch core.entitlements), enforced in
# production. Set explicitly to override: 1/true = allow-all, anything else = enforce.
ENTITLEMENTS_DEV_ALLOW_ALL=

# Portal base URL; when set, the /[orgSlug]/locked entitlement page links to <url>/billing.
NEXT_PUBLIC_PORTAL_URL=

# KitStak Projects origin (app switcher, the item panel's Projects tab deep links).
NEXT_PUBLIC_PROJECTS_URL=http://localhost:3400
# KitStak Pulse origin (app switcher and the Profit tab on deals and accounts).
NEXT_PUBLIC_PULSE_URL=http://localhost:3500
