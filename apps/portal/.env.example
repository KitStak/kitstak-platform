# Copy to .env.local and fill in. Never commit real secrets.
NODE_ENV=development

# Shared KitStak core database. Dev runs against CRM's embedded Postgres:
#   pnpm --filter kitstak-crm db:start   (listens on 127.0.0.1:5544)
#   pnpm --filter kitstak-crm db:migrate
#   pnpm --filter kitstak-crm db:seed
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/kitstak

# MUST be the same value in every KitStak app (Portal, CRM, WMS, Projects, Pulse) — the session cookie is shared.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# This app's own origin.
BETTER_AUTH_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Sibling origins allowed to make mutating auth calls (BLUEPRINT.md §1.5).
TRUSTED_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:3400,http://localhost:3500

# Launcher tile targets (absolute origins; BLUEPRINT.md §6).
NEXT_PUBLIC_CRM_URL=http://localhost:3100
NEXT_PUBLIC_WMS_URL=http://localhost:3000
NEXT_PUBLIC_PROJECTS_URL=http://localhost:3400
NEXT_PUBLIC_PULSE_URL=http://localhost:3500

# Entitlements. Stripe is DEFERRED: there is no checkout or webhook in this app. Dev/test
# default to allow-all so nothing blocks local work; production must leave this UNSET and
# grant modules explicitly: pnpm --filter @kitstak/entitlements grant grant <org-slug> <crm|wms|projects|pulse>
ENTITLEMENTS_DEV_ALLOW_ALL=1

# Optional: cookie domain for cross-subdomain SSO in prod (e.g. .kitstak.io). Leave unset in dev.
# AUTH_COOKIE_DOMAIN=

# Optional: client-IP trust for Better Auth's shared DB rate limiter (same contract as CRM/WMS):
# unset/'0' → Better Auth defaults (Vercel-safe), '1' → fronting proxy overwrites
# x-forwarded-for/x-real-ip, anything else → comma list of trusted proxy IPs/CIDRs.
# TRUST_PROXY=

# Optional: Drizzle pool size (default 5).
# DB_POOL_MAX=5
