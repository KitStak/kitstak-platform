# Copy to .env.local and fill in. Never commit real secrets.
NODE_ENV=development

# Shared KitStak core database. Dev runs against CRM's embedded Postgres:
#   pnpm --filter kitstak-crm db:start   (listens on 127.0.0.1:5544)
#   pnpm --filter kitstak-crm db:migrate
#   pnpm --filter kitstak-crm db:seed
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/kitstak

# MUST be the same value in every KitStak app (Portal, CRM, WMS, Projects, Pulse). The session cookie is shared.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# This app's own origin.
BETTER_AUTH_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Sibling origins allowed to make mutating auth calls (BLUEPRINT.md §1.5).
TRUSTED_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:3400,http://localhost:3500

# Launcher tile targets (absolute origins; BLUEPRINT.md §6).
NEXT_PUBLIC_CRM_URL=http://localhost:3100
NEXT_PUBLIC_WMS_URL=http://localhost:3000
NEXT_PUBLIC_PROJECTS_URL=http://localhost:3400
NEXT_PUBLIC_PULSE_URL=http://localhost:3500

# Entitlements. With 1, every app is open to every org (local default). Set it to 0 here and in each
# product app to see real trials, plans, view only and lock screens (docs/billing/DEV.md).
# Production keeps 1 only until the go live step that removes it (docs/billing/GO-LIVE.md).
ENTITLEMENTS_DEV_ALLOW_ALL=1

# ---------------------------------------------------------------------------------------------
# Signup and billing (docs/billing/CONTRACTS.md section 16.1). Everything below is optional.
# Never commit real values. Keys live only in .env.local or in the host's env settings.
# ---------------------------------------------------------------------------------------------

# Stripe. Leave both EMPTY for local work: with no key and NODE_ENV not "production", the built in
# test gateway runs, screens say "Test mode" and no real money moves. In production with no key,
# billing is off and says so. To try real Stripe test mode, put your own sk_test_ key and the
# whsec_ secret from `stripe listen -f localhost:3300/api/billing/webhooks/stripe` here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Billing Portal configuration id (bpc_...) printed by: pnpm -F @kitstak/billing stripe:setup apply
# STRIPE_PORTAL_CONFIGURATION_ID=
# 1 turns Stripe Tax on. Leave off until tax registrations are set in the Stripe account.
# STRIPE_AUTOMATIC_TAX=
# Optional fixed signing secret for the test gateway. Default: derived from BETTER_AUTH_SECRET.
# BILLING_TEST_WEBHOOK_SECRET=

# Bearer secret for /api/billing/jobs/tick. Required in production. Unset locally: the route is open.
# CRON_SECRET=

# Email (KitStak's Resend account, packages/mail): sign-in and verification codes, password
# resets, invites, trial and billing mail. With no RESEND_API_KEY outside production, mail goes to
# the dev outbox at /dev/outbox. To try real sends locally: a Resend API key,
# EMAIL_FROM=KitStak <onboarding@resend.dev> (Resend's shared test sender) and an address on your
# Resend account or delivered@resend.dev. EMAIL_PROVIDER=outbox keeps mail local even with a key.
# EMAIL_PROVIDER=
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=

# Social sign in. A button shows only when both the id and the secret of its provider are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Marketing site origin ("Talk to us", Terms, Privacy, pricing links). Default in production:
# https://kitstak.com. Default everywhere else: the local site, http://localhost:3600.
# NEXT_PUBLIC_SITE_URL=
# Legal links on signup and sign in. Default: ${NEXT_PUBLIC_SITE_URL}/terms and /privacy.
# NEXT_PUBLIC_TERMS_URL=
# NEXT_PUBLIC_PRIVACY_URL=

# The "From" block on invoices. Name default: KitStak LLC. Split address lines with a bar,
# like 1 Main St|Austin, TX 78701|US. The address and tax ID are not printed until they are set.
# BILLING_SELLER_NAME=
# BILLING_SELLER_ADDRESS=
# BILLING_SELLER_TAX_ID=
# Billing help at the foot of every billing page. Address default: hello@kitstak.com. The page
# names a reply time only once this is set, for example: 1 business day
# BILLING_SUPPORT_EMAIL=
# BILLING_SUPPORT_REPLY_TIME=

# Optional: cookie domain for cross-subdomain SSO in prod (e.g. .kitstak.io). Leave unset in dev.
# AUTH_COOKIE_DOMAIN=

# Optional: client-IP trust for Better Auth's shared DB rate limiter (same contract as CRM/WMS):
# unset/'0' → Better Auth defaults (Vercel-safe), '1' → fronting proxy overwrites
# x-forwarded-for/x-real-ip, anything else → comma list of trusted proxy IPs/CIDRs.
# TRUST_PROXY=

# Optional: Drizzle pool size (default 5).
# DB_POOL_MAX=5
