    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:drop": "tsx scripts/db-reset.ts",
    "db:fixtures": "tsx scripts/seed-fixtures.ts",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed && npm run db:fixtures",
    "db:verify": "tsx scripts/verify-ledger.ts",
    "audit:dead-clicks": "playwright test --project=dead-click-audit"
  },
