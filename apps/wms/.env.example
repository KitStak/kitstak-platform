# KitStaks WMS environment variables.
# Copy to .env.local and fill in real values. .env.local is gitignored.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Database (Postgres) -----------------------------------------------------

# Runtime connection. Unset = local PGlite at .data/pglite (auto-migrated on first open).
# On Vercel use the Supabase pooler in TRANSACTION mode (port 6543), e.g.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct / session connection used by `npm run db:migrate` (and drizzle-kit studio), e.g.
#   postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Falls back to DATABASE_URL when unset (then, on the transaction pooler, db:migrate runs
# without its concurrency lock: set DIRECT_URL for deploy-time migrations).
DIRECT_URL=

# Optional: connections per server instance (default 3 on Vercel, 5 elsewhere).
DATABASE_POOL_MAX=

# --- File storage (Supabase Storage) ----------------------------------------

# When BOTH are set, file bytes (attachments, imports, exports, prints) go to the private
# Supabase Storage bucket "wms-files" (created on first upload). Otherwise they stay on local
# disk under KITSTAK_FILES_DIR (default .data/files). Vercel has no persistent disk: set these.
# The service-role key is a server-only secret: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local disk root for file bytes when Supabase Storage is not configured.
KITSTAK_FILES_DIR=

# --- Required ---------------------------------------------------------------

# Better Auth signing secret (min 32 chars) — IDENTICAL across every KitStak app
# (shared SSO, BLUEPRINT.md §1.5). Required in production: the app refuses to start
# without it. In dev, when unset, a per-install random secret is generated and
# persisted to .data/better-auth-dev-secret (gitignored) — never a repo constant.
BETTER_AUTH_SECRET=

# This app's own origin (http://localhost:3000 in dev; https://wms.kitstak.io in prod).
BETTER_AUTH_URL=

# Comma-separated sibling origins (portal + CRM + WMS) allowed to make auth calls.
TRUSTED_ORIGINS=

# Key encrypting integration credentials at rest (AES-256-GCM): 32 bytes as 64 hex chars
# or base64. REQUIRED IN PRODUCTION — set it explicitly now (auth review 2026-11-11, M6):
# the SESSION_SECRET-derived fallback is deprecated, and SESSION_SECRET retirement must
# be sequenced AFTER INTEGRATION_KEY is set or stored credentials become undecryptable.
INTEGRATION_KEY=

# Secret used to sign the "kitstak_session" JWT cookie (HS256). At least 32 bytes.
# Required in production (the app throws at first use if missing).
# RETIREMENT: keep until INTEGRATION_KEY is set everywhere (it is the HKDF fallback for
# integration-credential encryption), then drop (BLUEPRINT.md §1.5).
SESSION_SECRET=

# Bearer token protecting /api/cron/tick (external scheduler trigger). On Vercel, Vercel Cron
# (vercel.json, every minute) sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional ---------------------------------------------------------------

# Password given to every seeded demo user by `npm run db:seed` / `db:reset`.
# Defaults to the documented local demo password when unset.
SEED_PASSWORD=

# Set to 1 to show the seeded demo login on /login. Ignored (always hidden) when
# NODE_ENV=production. Leave unset anywhere the login page is reachable by others.
DEMO_MODE=

# Set to 1 to allow db:seed / db:reset when NODE_ENV=production. Never set in real prod.
ALLOW_PROD_SEED=

# Set to 0 to keep the in-process scheduler (started from src/instrumentation.ts) off.
# It never starts on Vercel (VERCEL is set there); Vercel Cron calls /api/cron/tick instead.
SCHEDULER_ENABLED=

# --- E2E tests (Playwright) -------------------------------------------------

# Base URL of the running app. Defaults to http://localhost:3000.
E2E_BASE_URL=

# Password used by tests/e2e/fixtures to log in as each role. Defaults to SEED_PASSWORD.
E2E_PASSWORD=


# --- Entitlements (BLUEPRINT.md §3) -----------------------------------------

# Module entitlement gate (Stripe deferred: grants are manual via
# `pnpm --filter @kitstak/entitlements grant`). UNSET = allow-all everywhere except
# NODE_ENV=production (dev/test/e2e never touch core.entitlements), enforced in
# production. Set explicitly to override: 1/true = allow-all, anything else = enforce.
ENTITLEMENTS_DEV_ALLOW_ALL=

# Portal base URL; when set, the /locked entitlement page links to <url>/billing.
NEXT_PUBLIC_PORTAL_URL=

# KitStak Projects origin (app switcher, "Project tasks" panel deep links on order and work order pages).
NEXT_PUBLIC_PROJECTS_URL=http://localhost:3400

# KitStak Pulse origin (app switcher, "Job profit" card on work orders, "Client profit" strip on clients).
NEXT_PUBLIC_PULSE_URL=http://localhost:3500
